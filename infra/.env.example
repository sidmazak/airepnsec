# AI Secretary — Docker Compose environment template.
# Copy to `infra/.env`, then fill the required values below.
# Never commit the filled-in .env. Use URL-safe passwords (hex/base64url): a raw
# password containing @ : / # ? must be URL-encoded in DATABASE_URL.

# --- Published host port ---------------------------------------------------
# Change if port 3000 is already in use (the reverse proxy should target this).
APP_PORT=3000

# --- PostgreSQL (required by docker-compose.yml) ---------------------------
POSTGRES_USER=ais
POSTGRES_PASSWORD=
POSTGRES_DB=ais

# Optional explicit connection string. Leave unset to build it from the values
# above. If set, it must point at the compose `db` service from inside the app
# container (host `db`, port 5432) and use the same credentials.
# DATABASE_URL=postgresql://ais:CHANGE_ME@db:5432/ais?schema=public

# --- Encryption key --------------------------------------------------------
# Encrypts provider API keys and integration credentials at rest.
# Generate once:  openssl rand -hex 32
# Changing it later does NOT re-encrypt existing secrets; back it up securely.
# Leave empty to auto-generate /app/.data/secret.key in the app_data volume.
APP_SECRET=

# --- Public URL / webhooks (optional unless using Twilio) ------------------
# The exact HTTPS origin users/providers reach. Used only as a fallback for
# Twilio signature validation when an integration's publicBaseUrl is unset.
# Payment (Stripe) webhooks do not use it.
# PUBLIC_BASE_URL=https://receptionist.example.com

# --- Worker topology (optional) -------------------------------------------
# On multi-replica deployments keep workers on exactly one instance, or leave
# workers enabled everywhere (DB leases prevent duplicate work) and accept the
# extra lease attempts. Set to 1 on purely web-facing replicas if preferred.
# AIS_DISABLE_WORKERS=1
# AIS_WORKER_AUTOMATION=0
# AIS_WORKER_OUTBOX=0
# AIS_WORKER_DATASOURCES=0
