// AI Secretary — data model
// Portable across SQLite (sandbox/dev) and PostgreSQL (production self-host).
// Conventions: money = integer cents; enums = String validated in code (SQLite has no enums);
// JSON payloads = String columns parsed in code; every business record carries orgId.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (Windows/macOS/whatever); Debian bookworm for the Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  businessType   String   @default("generic") // apartment_rental | car_rental | salon | clinic | contractor | generic
  timezone       String   @default("UTC")
  locale         String   @default("en")
  currency       String   @default("USD")
  address        String   @default("")
  phone          String   @default("")
  email          String   @default("")
  openingHours   String   @default("{}") // JSON: { "1": [["09:00","17:00"]], ... } dow 0=Sun
  holidays       String   @default("[]") // JSON: ["2025-12-25"]
  policies       String   @default("{}") // JSON: cancellation, deposit, quiet hours, consent
  aiIdentity     String   @default("{}") // JSON: tone, greeting, closing, escalationNote
  collectionsCfg String   @default("{}") // JSON: schedule days, templates, quiet hours, max touches
  demo           Boolean  @default(false)
  setupState     String   @default("{}") // JSON: step -> {done, savedAt}
  setupComplete  Boolean  @default(false)
  dataMode       String   @default("hybrid") // local_only | hybrid | cloud_first
  // Runtime switch for the AI receptionist: running | paused | stopped.
  // paused = inbound is recorded for staff but the assistant does not reply;
  // stopped = inbound webhooks are acknowledged but nothing is answered or stored.
  receptionistStatus String @default("running")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  customers        Customer[]
  services         Service[]
  staff            Staff[]
  bookings         Booking[]
  invoices         Invoice[]
  payments         Payment[]
  ledgerEntries    LedgerEntry[]
  webhookEvents    WebhookEvent[]
  integrations     Integration[]
  knowledgeDocs    KnowledgeDoc[]
  dataSources      DataSource[]
  conversations    Conversation[]
  outbox           OutboxMessage[]
  providerConfigs  ProviderConfig[]
  aiLogs           AiLog[]
  automations      Automation[]
  auditEvents      AuditEvent[]
  calendarBlocks   CalendarBlock[]
  invites          Invite[]
  telephonyLines   TelephonyLine[]
  telephonyCalls   TelephonyCall[]
  settings         AppSetting[]
  ssoConfigs       SsoConfig[]
  scimConfig       ScimConfig?
}

model User {
  id              String   @id @default(cuid())
  orgId           String
  email           String   @unique
  passwordHash    String
  name            String
  role            String   @default("owner") // owner | admin | agent | viewer
  active          Boolean  @default(true) // deactivated members keep their history but cannot sign in
  twoFactorSecret String   @default("") // AES-256-GCM encrypted TOTP secret (only meaningful while enrolling/enabled)
  twoFactorEnabled Boolean @default(false)
  twoFactorLastCounter Int @default(0) // highest consumed TOTP step — blocks replay of the same code
  // Last login timestamp — feeds the sliding time-window permissions policy.
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Federation: an OIDC/SAML subject claim links a remote IdP user to this local row.
  ssoProvider     String   @default("") // oidc | saml (empty = local only)
  ssoSubject      String   @default("") // claim.sub or nameId from the IdP
  organization    Organization @relation(fields: [orgId], references: [id])
  sessions        Session[]
  invitesSent     Invite[]
  resetTokens     PasswordResetToken[]
}

/// Federated sign-in configuration for one organisation and one protocol. One row
/// per (org, kind); `enabled` is a flag turned on from the admin UI after the operator
/// confirms the IdP token signing / account-linking policy in place. `secrets` holds the
/// encrypted client secret / certificate so nothing sensitive leaves the server.
model SsoConfig {
  id        String   @id @default(cuid())
  orgId     String
  kind      String   // oidc | saml
  enabled   Boolean  @default(false)
  config    String   @default("{}") // JSON: issuer/issuerUrl, clientId, redirectUri, scopes[], autoProvision, defaultRole, domainAllowlist[]
  secrets   String   @default("{}") // JSON: encrypted values (client secret, idp cert, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  @@unique([orgId, kind])
  @@index([orgId])
}

/// SCIM 2.0 provisioning for one organisation. The IdP calls back here to create/manage
/// users; the admin hands out the bear-token via the UI and revokes it at will. Passwords
/// provisioned through SCIM are random until the user resets via the standard flow.
model ScimConfig {
  id          String   @id @default(cuid())
  orgId       String
  url         String   @default("") // absolute SCIM endpoint
  enabled     Boolean  @default(true)
  tokenHash   String   @unique // hashed SCIM bear token (SHA-256 of the plain token)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  @@unique([orgId])
}

/// A pending invitation to join the organisation. The token is stored hashed —
/// the plain token is only ever shown once, in the invite email / invite link.
model Invite {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  role         String   @default("agent") // owner | admin | agent | viewer
  tokenHash    String   @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  invitedBy    User     @relation(fields: [invitedById], references: [id])
  @@index([orgId])
  @@index([email])
}

/// Single-use password reset / "set your password" token (hashed at rest).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// Shared (database-backed) rate-limit bucket so limits hold across app instances.
model RateBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  orgId     String
  key       String
  value     String   @default("") // JSON or scalar string
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  @@unique([orgId, key])
}

/**
 * Instance-wide lease for background workers. A single row per worker name makes
 * the automation runner / outbox dispatcher / data-source sync safe when more than
 * one app instance (or a manual "run now" request) fires at the same time.
 * `expiresAt` is moved into the past on clean completion; a crashed holder is
 * recovered automatically once the TTL lapses.
 */
model WorkerLease {
  name      String    @id
  holder    String    @default("")
  expiresAt DateTime
  lastRunAt DateTime?
  lastError String    @default("")
  updatedAt DateTime  @updatedAt
  @@index([expiresAt])
}

model Customer {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  email           String   @default("")
  phone           String   @default("")
  notes           String   @default("")
  tags            String   @default("[]") // JSON string[]
  consentContact  Boolean  @default(true) // consent for service communications
  optOut          Boolean  @default(false) // explicit opt-out of outbound messaging
  externalRef     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [orgId], references: [id])
  bookings        Booking[]
  invoices        Invoice[]
  conversations   Conversation[]
  @@index([orgId])
  @@index([orgId, phone])
  @@index([orgId, email])
}

model Service {
  id               String  @id @default(cuid())
  orgId            String
  name             String
  description      String  @default("")
  category         String  @default("general")
  durationMin      Int     @default(60)
  priceCents       Int     @default(0)
  currency         String  @default("USD")
  bufferBeforeMin  Int     @default(0)
  bufferAfterMin   Int     @default(0)
  maxPerSlot       Int     @default(1) // parallel capacity when no specific staff
  requiresDeposit  Boolean @default(false)
  depositCents     Int     @default(0)
  active           Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [orgId], references: [id])
  bookings         Booking[]
  staffLinks       StaffService[]
  @@index([orgId])
}

model Staff {
  id        String  @id @default(cuid())
  orgId     String
  name      String
  role      String  @default("")
  email     String  @default("")
  phone     String  @default("")
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  serviceLinks StaffService[]
  bookings  Booking[]
  workingHours WorkingHour[]
  calendarBlocks CalendarBlock[]
  @@index([orgId])
}

model StaffService {
  staffId    String
  serviceId  String
  staff      Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([staffId, serviceId])
}

model WorkingHour {
  id      String @id @default(cuid())
  orgId   String
  staffId String? // null = org-wide default hours
  dow     Int // 0=Sunday .. 6=Saturday
  startMin Int // minutes from midnight
  endMin  Int
  staff   Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@index([orgId])
  @@index([staffId])
}

/// A time range the business cannot be booked for, coming from an external
/// calendar (Google Calendar free/busy) or created manually by staff/AI.
/// Blocks are read by the availability engine — a slot that overlaps a block
/// is never offered or booked.
model CalendarBlock {
  id         String   @id @default(cuid())
  orgId      String
  staffId    String? // null = blocks the whole business
  source     String   @default("manual") // manual | google_calendar
  externalId String   @default("") // provider event id (google) — empty for manual blocks
  title      String   @default("")
  startAt    DateTime
  endAt      DateTime
  allDay     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@index([orgId, startAt])
  @@index([orgId, staffId, startAt])
  @@index([orgId, source, externalId])
}

model Booking {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String
  serviceId   String
  staffId     String?
  startAt     DateTime
  endAt       DateTime
  status      String   @default("confirmed") // pending | confirmed | cancelled | completed | no_show
  source      String   @default("manual") // manual | ai_chat | ai_voice | web | import
  notes       String   @default("")
  cancelReason String  @default("")
  priceCents  Int      @default(0) // snapshot of service price at booking time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])
  staff       Staff?   @relation(fields: [staffId], references: [id])
  @@index([orgId, startAt])
  @@index([orgId, status])
  @@index([customerId])
  @@index([staffId, startAt])
}

model Invoice {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String
  number      String
  status      String   @default("draft") // draft | sent | partial | paid | void | uncollectible
  currency    String   @default("USD")
  subtotalCents Int    @default(0)
  taxCents    Int      @default(0)
  totalCents  Int      @default(0)
  paidCents   Int      @default(0) // denormalized verified sum, source of truth = ledger+payments
  issueDate   DateTime
  dueDate     DateTime
  rentalPeriod String  @default("") // JSON: {start,end,recurrence} for rentals
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  ledgerEntries LedgerEntry[]
  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([customerId])
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  qty            Int    @default(1)
  unitPriceCents Int    @default(0)
  totalCents     Int    @default(0)
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
}

model Payment {
  id               String   @id @default(cuid())
  orgId            String
  invoiceId        String
  amountCents      Int
  method           String   @default("manual") // manual | card | bank | cash | online
  reference        String   @default("")
  status           String   @default("verified") // pending_verification | verified | failed | refunded
  source           String   @default("manual") // manual | webhook | customer_claim
  idempotencyKey   String?  @unique
  externalEventId  String?  @unique
  verifiedAt       DateTime?
  verifiedBy       String   @default("") // userId or "webhook"
  note             String   @default("")
  createdAt        DateTime @default(now())
  organization     Organization @relation(fields: [orgId], references: [id])
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  ledgerEntries    LedgerEntry[]
  @@index([orgId])
  @@index([invoiceId])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  orgId         String
  ts            DateTime @default(now())
  type          String   // charge | payment | refund | adjustment | reversal
  debitAccount  String   // accounts_receivable | cash | revenue | refunds | fees | bad_debt ...
  creditAccount String
  amountCents   Int
  invoiceId     String?
  paymentId     String?
  bookingId     String?
  memo          String   @default("")
  reversalOfId  String?  // points at the entry being reversed
  createdBy     String   @default("system")
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [orgId], references: [id])
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])
  payment       Payment?  @relation(fields: [paymentId], references: [id])
  @@index([orgId, ts])
  @@index([invoiceId])
  @@index([paymentId])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  orgId          String
  provider       String   @default("generic")
  eventId        String   @unique
  payload        String   @default("")
  signatureValid Boolean  @default(false)
  result         String   @default("received") // received | processed | duplicate | rejected
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [orgId], references: [id])
  @@index([orgId])
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  source    String   @default("manual") // manual | paste | file | datasource
  content   String
  approved  Boolean  @default(false) // only approved docs are served to the AI
  tags      String   @default("[]")
  dataSourceId String? // set when the row was ingested from an external data source
  externalId   String @default("") // stable row id in the source (idempotent sync key)
  contentHash  String @default("") // sha256 of extracted text; unchanged rows are skipped on re-sync
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]
  @@unique([dataSourceId, externalId])
  @@index([orgId])
  @@index([dataSourceId])
}

/**
 * Bring-your-own data source for RAG. Connects to an external relational/SQL
 * database or a JSON HTTP endpoint, extracts rows as documents, and indexes them
 * into the same knowledge/RAG pipeline (chunked + embedded with the org's
 * embedding provider). Secrets (connection strings / credentials) are stored
 * AES-256-GCM encrypted in connectionEnc and NEVER returned to the client.
 *
 * kind: sqlite | postgres | mysql | http_json
 * configJson: { query | table, idColumn, titleColumn, textColumns[], contentType, limit, allowPrivate? }
 */
model DataSource {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  kind            String   // sqlite | postgres | mysql | http_json
  connectionEnc   String   @default("") // AES-256-GCM encrypted JSON of connection fields (host/url/user/password/path)
  configJson      String   @default("{}") // query/table + column mapping
  enabled         Boolean  @default(false)
  autoSync        Boolean  @default(false)
  syncIntervalMin Int      @default(360) // scheduled re-sync interval (used when autoSync is on)
  lastTestAt      DateTime?
  lastTestOk      Boolean  @default(false)
  lastTestError   String   @default("")
  lastSyncAt      DateTime?
  lastSyncOk      Boolean  @default(false)
  lastSyncError   String   @default("")
  lastSyncStats   String   @default("{}") // JSON: { fetched, created, updated, deleted, unchanged, failed, ms }
  documentCount   Int      @default(0)
  chunkCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [orgId], references: [id])
  documents       KnowledgeDoc[]
  @@index([orgId])
}

model KnowledgeChunk {
  id       String @id @default(cuid())
  orgId    String
  docId    String
  ord      Int
  text     String
  vector   String @default("[]") // JSON float[] — dense embedding (neural) or hashed lexical fallback; swap for pgvector in production
  model    String @default("") // embedding model identifier used for this vector ("Xenova/all-MiniLM-L6-v2", ollama model, endpoint model, or "local_lexical_hash")
  dim      Int    @default(0) // vector dimension; dense cosine is only computed when chunk.model === active model and dim matches
  doc      KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([docId])
  @@index([orgId])
  @@index([model])
}

model Conversation {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String?
  channel     String   @default("web") // web | voice_test | phone | sms | whatsapp | realtime
  status      String   @default("open") // open | waiting_human | closed
  aiEnabled   Boolean  @default(true)
  summary     String   @default("")
  contactName String   @default("")
  externalRef String   @default("") // telephony thread key: Twilio CallSid (voice) or "sms:{from}" (sms)
  // Serializes overlapping receptionist turns for the same thread (two SMS arriving
  // together, web chat double-send, voice gather racing a status callback). The
  // token prevents one worker from releasing a lock another worker now owns.
  turnLockToken String   @default("")
  turnLockedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  messages    Message[]
  @@index([orgId, updatedAt])
  @@index([orgId, channel, externalRef])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  orgId          String
  role           String   // customer | assistant | agent | system
  content        String
  meta           String   @default("{}") // JSON: toolCalls, usage, provider info (never secrets)
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model OutboxMessage {
  id           String   @id @default(cuid())
  orgId        String
  channel      String   @default("email") // email | sms | whatsapp | webhook | inapp
  recipient    String
  subject      String   @default("")
  body         String
  html         String   @default("") // rich HTML body (email only); dispatcher sends when non-empty
  status       String   @default("queued") // queued | sent | failed | skipped
  statusReason String   @default("") // e.g. "no channel configured" — honest states only
  attempts     Int      @default(0) // delivery attempts by the dispatcher (backoff: 2^n minutes, max 5)
  relatedType  String   @default("") // invoice | booking | conversation
  relatedId    String   @default("")
  dedupeKey    String?  @unique
  scheduledFor DateTime @default(now())
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  @@index([orgId, status])
}

model ProviderConfig {
  id          String   @id @default(cuid())
  orgId       String
  capability  String   // llm | embedding | stt | tts | realtime | rerank | vision
  provider    String   @default("none") // ollama | openai_compatible | browser | local_neural | local_lexical | none
  label       String   @default("")
  baseUrl     String   @default("")
  model       String   @default("")
  apiKeyEnc   String   @default("") // AES-256-GCM ciphertext; never returned to client
  configJson  String   @default("{}")
  enabled     Boolean  @default(false)
  lastTestAt  DateTime?
  lastTestOk  Boolean  @default(false)
  lastTestError String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  @@unique([orgId, capability])
  @@index([orgId])
}

model AiLog {
  id             String   @id @default(cuid())
  orgId          String
  ts             DateTime @default(now())
  capability     String
  provider       String
  model          String   @default("")
  latencyMs      Int      @default(0)
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  ok             Boolean  @default(true)
  errorSanitized String   @default("")
  conversationId String   @default("")
  organization   Organization @relation(fields: [orgId], references: [id])
  @@index([orgId, ts])
}

model Automation {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  description   String   @default("")
  enabled       Boolean  @default(false)
  testMode      Boolean  @default(true) // test mode logs actions instead of executing sends
  triggerType   String   // invoice_overdue | booking_created | booking_reminder | conversation_escalated | manual
  triggerCfg    String   @default("{}") // JSON
  conditions    String   @default("[]") // JSON array of {field,op,value}
  delayMinutes  Int      @default(0)
  actions       String   @default("[]") // JSON array of {type, cfg}
  maxRunsPerDay Int      @default(20)
  quietHours    String   @default("{}") // JSON {start:"22:00", end:"08:00"}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [orgId], references: [id])
  runs          AutomationRun[]
  @@index([orgId])
}

model AutomationRun {
  id           String   @id @default(cuid())
  orgId        String
  automationId String
  status       String   @default("running") // running | success | failed | skipped
  attempt      Int      @default(1)
  dedupeKey    String   @default("")
  input        String   @default("{}")
  output       String   @default("{}")
  error        String   @default("")
  scheduledFor DateTime @default(now())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@unique([automationId, dedupeKey])
  @@index([orgId, scheduledFor])
}

/**
 * Third-party integration (BYOK — bring your own key).
 * kind: smtp | twilio_sms | twilio_whatsapp | twilio_voice | sms_gateway | stripe |
 *       webhook_out | caldav
 * configJson: non-secret config (host, port, from address, destination URL, events…)
 * secretsEnc: AES-256-GCM encrypted JSON of secret fields — NEVER returned to the client.
 * Singleton per kind is enforced in code for smtp / twilio_sms / twilio_whatsapp /
 * twilio_voice / sms_gateway / stripe / caldav; webhook_out allows many rows (one per
 * destination URL).
 */
model Integration {
  id            String    @id @default(cuid())
  orgId         String
  kind          String
  label         String    @default("")
  configJson    String    @default("{}")
  secretsEnc    String    @default("")
  enabled       Boolean   @default(false)
  lastTestAt    DateTime?
  lastTestOk    Boolean   @default(false)
  lastTestError String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organization  Organization @relation(fields: [orgId], references: [id])
  @@index([orgId])
  @@index([orgId, kind])
}

model TelephonyLine {
  id               String   @id @default(cuid())
  orgId            String
  integrationId    String   @default("")
  label            String   @default("")
  phoneNumber      String   @default("") // agent's direct line / extension E.164
  destinationKind  String   @default("phone") // phone | user | department
  destinationValue String   @default("") // phone number or user/queue id
  priority         Int      @default(100)
  enabled          Boolean  @default(true)
  acceptingCalls   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [orgId], references: [id])
  @@index([orgId])
  @@index([orgId, enabled])
}

model TelephonyCall {
  id          String    @id @default(cuid())
  orgId       String
  callSid     String    @default("")
  from        String    @default("")
  to          String    @default("")
  lineId      String    @default("")
  status      String    @default("started") // started | answered | completed | failed | missed | no_answer
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int       @default(0)
  meta        String    @default("{}")
  organization Organization @relation(fields: [orgId], references: [id])
  @@index([orgId, startedAt])
  @@index([orgId, status])
}

model AuditEvent {
  id        String   @id @default(cuid())
  orgId     String
  ts        DateTime @default(now())
  actorType String   @default("user") // user | ai | system | webhook
  actorId   String   @default("")
  action    String   // booking.created, invoice.paid, settings.updated, ...
  entity    String   @default("")
  entityId  String   @default("")
  meta      String   @default("{}")
  organization Organization @relation(fields: [orgId], references: [id])
  @@index([orgId, ts])
  @@index([orgId, entity])
}
